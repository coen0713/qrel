# Copy to .env and fill in. The real .env is gitignored and must stay that way.
#
# Used only by `reval contaminate generate`, which produces the synthetic query
# set for the M3 headline experiment. Nothing else in the harness needs a key:
# every metric, detector and BM25 run works without one.
#
# Deliberately repo-local rather than a user-wide environment variable, since
# ANTHROPIC_API_KEY is read by other Anthropic tooling on the same machine.
ANTHROPIC_API_KEY=sk-ant-...
